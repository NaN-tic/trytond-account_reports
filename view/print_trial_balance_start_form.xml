copyright notices and license terms. -->
<form col="8">
    <label name="company"/>
    <field name="company"/>
    <label name="show_digits"/>
    <field name="show_digits" xexpand="0"/>
    <label name="output_format"/>
    <field name="output_format"/>
    <label name="timeout"/>
    <field name="timeout" xexpand="0"/>
    <group id="filter_checkboxes" col="10" colspan="8">
        <label name="show_summary_lines"/>
        <field name="show_summary_lines"/>
        <label name="add_initial_balance"/>
        <field name="add_initial_balance"/>
        <label name="moves_or_initial"/>
        <field name="moves_or_initial"/>
        <label name="split_parties"/>
        <field name="split_parties"/>
        <label name="only_moves"/>
        <field name="only_moves"/>
    </group>
    <notebook colspan="8">
        <page id="periods" string="Periods">
            <label name="fiscalyear"/>
            <field name="fiscalyear"/>
            <newline/>
            <label name="start_period"/>
            <field name="start_period"/>
            <label name="end_period"/>
            <field name="end_period"/>
            <label name="start_date"/>
            <field name="start_date"/>
            <label name="end_date"/>
            <field name="end_date"/>
            <separator id="second_balance" string="Comparison Period" colspan="4"/>
            <label name="comparison_fiscalyear"/>
            <field name="comparison_fiscalyear"/>
            <newline/>
            <label name="comparison_start_period"/>
            <field name="comparison_start_period" xfill="0" xalign="0"/>
            <label name="comparison_end_period"/>
            <field name="comparison_end_period" xfill="0" xalign="0"/>
        </page>
        <page name="accounts">
            <label id="all_accounts" string="All accounts if Empty" colspan="4"/>
            <field name="accounts" colspan="4"/>
        </page>
        <page name="parties">
            <label id="all_parties" string="All parties if Empty" colspan="4"/>
            <field name="parties" colspan="4"/>
        </page>
    </notebook>
</form>
