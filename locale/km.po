#, python-format
msgctxt "model:ir.message,text:fiscalyear_end_date"
msgid "The final posting date does not match the fiscal year \"%(fiscalyear)s\"."
msgstr ""
"កាលបរិច្ឆេទកត់ត្រាក្នុងបញ្ជីចុងក្រោយមិនត្រូវនឹងឆ្នាំសារពើពន្ធ "
"«%(fiscalyear)s»។"

#, python-format
msgctxt "model:ir.message,text:fiscalyear_start_date"
msgid "The initial posting date does not match the fiscal year \"%(fiscalyear)s\"."
msgstr ""
"កាលបរិច្ឆេទកត់ត្រាក្នុងបញ្ជីដំបូងមិនត្រូវនឹងឆ្នាំសារពើពន្ធ «%(fiscalyear)s»។"

msgctxt "model:ir.message,text:msg_all_parties"
msgid "All"
msgstr "ទាំងអស់"

msgctxt "model:ir.message,text:msg_invalid_date_range"
msgid ""
"The initial posting date must be before or equal to the final posting date."
msgstr ""
"កាលបរិច្ឆេទកត់ត្រាក្នុងបញ្ជីដំបូងត្រូវនៅមុន "
"ឬស្មើនឹងកាលបរិច្ឆេទកត់ត្រាក្នុងបញ្ជីចុងក្រោយ។"

msgctxt "model:ir.message,text:msg_missing_fiscalyear"
msgid "The fiscalyear selected it is not valid."
msgstr "ឆ្នាំសារពើពន្ធដែលបានជ្រើសរើសមិនត្រឹមត្រូវ។"

msgctxt "model:ir.message,text:msg_not_deductible_tax"
msgid "Not Deductible VAT"
msgstr "អាករលើតម្លៃបន្ថែមដែលមិនអាចកាត់កងបាន"

#, python-format
msgctxt "model:ir.message,text:msg_renumber_move"
msgid ""
"We have noticed that the sequence \"%(sequence)s\" pattern does not match the post number of \"%(move)s\".\n"
"Please proceed to renumber the records before consulting the journal report."
msgstr ""
"លំនាំលេខរៀង «%(sequence)s» មិនត្រូវនឹងលេខកត់ត្រាក្នុងបញ្ជីរបស់ «%(move)s»។\n"
"សូមដាក់លេខកំណត់ត្រាឡើងវិញ មុននឹងមើលរបាយការណ៍ទិនានុប្បវត្តិ។"

msgctxt "model:ir.message,text:msg_timeout_exception"
msgid ""
"Report computation timed out. You may consider increasing the timeout of the "
"account reports or export to XLS format."
msgstr ""
"ការគណនារបាយការណ៍បានអស់ពេលកំណត់។ អ្នកអាចបង្កើនពេលកំណត់នៃរបាយការណ៍គណនេយ្យ "
"ឬនាំចេញជាទ្រង់ទ្រាយ XLS។"

