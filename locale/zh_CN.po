#, python-format
msgctxt "model:ir.message,text:msg_renumber_move"
msgid ""
"We have noticed that the sequence \"%(sequence)s\" pattern does not match the post number of \"%(move)s\".\n"
"Please proceed to renumber the records before consulting the journal report."
msgstr ""
"编号序列“%(sequence)s”的模式与凭证“%(move)s”的过账编号不匹配。\n"
"请先重新编号记录，再查看日记账报表。"

msgctxt "model:ir.message,text:msg_timeout_exception"
msgid ""
"Report computation timed out. You may consider increasing the timeout of the"
" account reports or export to XLS format."
msgstr "报表计算超时。可考虑增加会计报表的超时时间或导出为 XLS 格式。"

